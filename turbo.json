{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "DIRECT_URL",
        "AUTH_*",
        "GOOGLE_CLIENT_*",
        "EMAIL_*",
        "ANTHROPIC_API_KEY",
        "PREMIUM_EMAILS",
        "STORAGE_*",
        "BLOB_READ_WRITE_TOKEN",
        "SUPABASE_SERVICE_ROLE_KEY",
        "VAPID_*",
        "CRON_SECRET",
        "VERCEL_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build", "^db:generate"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
