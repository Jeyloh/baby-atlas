# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:54322/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth
# NEXTAUTH_URL: Set this to the URL where your app is accessible
#
# Development: Optional (auto-detects from Host header for convenience)
#   - Works with localhost, LAN IPs, etc. without configuration
#
# Production/Self-Hosted: REQUIRED for security
#   - Set to your server's public URL
#   - Examples:
#     - Home server on LAN: http://192.168.1.100:3000
#     - Cloud server: http://your-ip:3000
#     - Domain with SSL: https://babyatlas.yourdomain.com
#
# SECURITY: Always set this explicitly when exposing to the internet
# to prevent Host header injection attacks
NEXTAUTH_URL="http://localhost:3000"
# AUTH_SECRET is required by NextAuth v5 - generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (for magic link - optional, leave empty to disable)
# Format: smtp://user:password@host:port or smtps://user:password@host:port (for SSL)
# Examples:
#   Resend: smtps://resend:re_YOUR_API_KEY@smtp.resend.com:465
#   Gmail:  smtps://you@gmail.com:app-password@smtp.gmail.com:465
EMAIL_SERVER=""
EMAIL_FROM="noreply@babyatlas.app"

# AI chat and AI insights (optional - leave empty to disable; /api/ai/insights returns 503 without it)
ANTHROPIC_API_KEY=""

# Journal photo storage. Photos are private family data and never get public URLs:
# they are served by /api/journal/photos/[photoId] after a household membership check.
#   local (default in development): files under apps/web/.uploads/ (git-ignored).
#       Does not work in production, serverless hosts have no writable disk.
#   supabase: a private bucket named "journal" (created on first use) through the
#       service role key above. The key stays on the server, never expose it to the browser.
#   vercel-blob: a private Vercel Blob store through BLOB_READ_WRITE_TOKEN (set by Vercel
#       when you connect a Blob store). Server side only.
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=""   # optional, replaces apps/web/.uploads
# STORAGE_DRIVER="supabase"
# STORAGE_DRIVER="vercel-blob"
# BLOB_READ_WRITE_TOKEN=""

# Premium (testing before payments exist)
# Comma-separated emails treated as Premium. RevenueCat (iOS) or Stripe (web)
# should later set User.isPremium through a webhook.
PREMIUM_EMAILS=""

# Local development only: sign in as this email at /api/dev/login without a
# magic link. Ignored outside `next dev`.
DEV_LOGIN_EMAIL=""

# Capacitor iOS shell: the hosted URL the native app loads (read by `pnpm cap:sync`)
# Defaults to http://localhost:3000. Use your HTTPS production URL for release builds.
CAP_SERVER_URL=""
