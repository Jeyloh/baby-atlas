generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Auth Models (NextAuth.js)
// ============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // Premium unlocks AI insights and advanced statistics. Logging is always free.
  isPremium     Boolean   @default(false) @map("is_premium")
  // Pinned one-tap shortcuts on the home screen, as QuickAction keys (max 4)
  quickActions  String[]  @default([]) @map("quick_actions")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  householdMemberships HouseholdMember[]
  sentInvites          HouseholdInvite[]
  journalEntries       JournalEntry[]
  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings?
  notificationLogs     NotificationLog[]
  childVisits          ChildVisit[]
  parentCheckIns       ParentCheckIn[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// Household & Children
// ============================================================================

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  HouseholdMember[]
  children Child[]
  invites  HouseholdInvite[]

  @@map("households")
}

enum HouseholdRole {
  OWNER
  ADMIN
  CAREGIVER
  VIEWER
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole @default(CAREGIVER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  // Optional: when set, only this email can accept. Share links leave it empty.
  email       String?
  role        HouseholdRole @default(CAREGIVER)
  // Random secret generated in code (cuids are not unguessable)
  token       String        @unique
  invitedById String?       @map("invited_by_id")
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("household_invites")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Child {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  name        String
  birthDate   DateTime @map("birth_date") @db.Date
  gender      Gender?
  photo       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sleepRecords       SleepRecord[]
  feedingRecords     FeedingRecord[]
  diaperRecords      DiaperRecord[]
  pumpingRecords     PumpingRecord[]
  growthRecords      GrowthRecord[]
  activityRecords    ActivityRecord[]
  temperatureRecords TemperatureRecord[]
  medicines          Medicine[]
  speechWords        SpeechWord[]
  pottyReadinessLogs PottyReadinessLog[]
  vaccinationRecords VaccinationRecord[]
  journalEntries     JournalEntry[]
  checkupRecords     CheckupRecord[]
  visits             ChildVisit[]

  @@map("children")
}

// ============================================================================
// Sleep Tracking
// ============================================================================

enum SleepType {
  NAP
  NIGHT
}

model SleepRecord {
  id        String    @id @default(cuid())
  childId   String    @map("child_id")
  startTime DateTime  @map("start_time")
  endTime   DateTime? @map("end_time")
  sleepType SleepType @default(NAP) @map("sleep_type")
  quality   Int? // 1-5 rating
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startTime])
  @@map("sleep_records")
}

// ============================================================================
// Feeding Tracking
// ============================================================================

enum FeedingType {
  BREAST
  BOTTLE
  SOLIDS
}

enum BreastSide {
  LEFT
  RIGHT
  BOTH
}

enum BottleContentType {
  FORMULA
  BREAST_MILK
}

model FeedingRecord {
  id          String      @id @default(cuid())
  childId     String      @map("child_id")
  feedingType FeedingType @map("feeding_type")
  startTime   DateTime    @map("start_time")
  endTime     DateTime?   @map("end_time")

  // Breastfeeding specific
  side                 BreastSide?
  leftDurationSeconds  Int?        @map("left_duration_seconds")
  rightDurationSeconds Int?        @map("right_duration_seconds")

  // Bottle specific
  amountMl          Int?               @map("amount_ml")
  bottleContentType BottleContentType? @map("bottle_content_type")

  // Solids specific
  foodItems String[] @map("food_items")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startTime])
  @@map("feeding_records")
}

// ============================================================================
// Diaper Tracking
// ============================================================================

enum DiaperType {
  WET
  DIRTY
  BOTH
  DRY
}

enum DiaperColor {
  YELLOW
  GREEN
  BROWN
  BLACK
  RED
  WHITE
  OTHER
}

enum DiaperConsistency {
  WATERY
  LOOSE
  SOFT
  FORMED
  HARD
}

enum DiaperSize {
  NEWBORN
  SIZE_1
  SIZE_2
  SIZE_3
  SIZE_4
  SIZE_5
  SIZE_6
}

enum DiaperAmount {
  SMALL
  MEDIUM
  LARGE
}

model DiaperRecord {
  id          String             @id @default(cuid())
  childId     String             @map("child_id")
  time        DateTime
  diaperType  DiaperType         @map("diaper_type")
  color       DiaperColor?
  consistency DiaperConsistency?
  size        DiaperSize?
  amount      DiaperAmount?
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, time])
  @@map("diaper_records")
}

// ============================================================================
// Pumping Tracking (Post-MVP)
// ============================================================================

model PumpingRecord {
  id        String      @id @default(cuid())
  childId   String      @map("child_id")
  startTime DateTime    @map("start_time")
  endTime   DateTime?   @map("end_time")
  amountMl  Int?        @map("amount_ml")
  side      BreastSide?
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startTime])
  @@map("pumping_records")
}

// ============================================================================
// Growth Tracking (Post-MVP)
// ============================================================================

model GrowthRecord {
  id                  String   @id @default(cuid())
  childId             String   @map("child_id")
  date                DateTime @db.Date
  weightKg            Float?   @map("weight_kg")
  heightCm            Float?   @map("height_cm")
  headCircumferenceCm Float?   @map("head_circumference_cm")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, date])
  @@map("growth_records")
}

// ============================================================================
// Activity Tracking (Post-MVP)
// ============================================================================

enum ActivityType {
  TUMMY_TIME
  BATH
  OUTDOOR_PLAY
  INDOOR_PLAY
  SCREEN_TIME
  SKIN_TO_SKIN
  STORYTIME
  TEETH_BRUSHING
  OTHER
}

model ActivityRecord {
  id           String       @id @default(cuid())
  childId      String       @map("child_id")
  activityType ActivityType @map("activity_type")
  startTime    DateTime     @map("start_time")
  endTime      DateTime?    @map("end_time")
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, startTime])
  @@map("activity_records")
}

// ============================================================================
// Temperature Tracking
// ============================================================================

model TemperatureRecord {
  id                 String   @id @default(cuid())
  childId            String   @map("child_id")
  time               DateTime
  temperatureCelsius Float    @map("temperature_celsius")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, time])
  @@map("temperature_records")
}

// ============================================================================
// Medicine Tracking (Post-MVP)
// ============================================================================

model Medicine {
  id               String   @id @default(cuid())
  childId          String   @map("child_id")
  name             String
  dosage           String
  frequency        String?
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  // Optional dose guard rails the parent enters themselves (never advice from the app)
  minIntervalHours Float?   @map("min_interval_hours")
  maxDosesPer24h   Int?     @map("max_doses_per_24h")
  remindNextDose   Boolean  @default(false) @map("remind_next_dose")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  child   Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  records MedicineRecord[]

  @@map("medicines")
}

model MedicineRecord {
  id          String   @id @default(cuid())
  medicineId  String   @map("medicine_id")
  time        DateTime
  dosageGiven String?  @map("dosage_given")
  skipped     Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId, time])
  @@map("medicine_records")
}

// ============================================================================
// Speech & Vocabulary (toddler)
// ============================================================================

enum SpeechCategory {
  WORD
  SOUND
  SIGN
}

model SpeechWord {
  id          String         @id @default(cuid())
  childId     String         @map("child_id")
  word        String
  category    SpeechCategory @default(WORD)
  firstSaidAt DateTime       @map("first_said_at") @db.Date
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, firstSaidAt])
  @@map("speech_words")
}

// ============================================================================
// Potty Training Readiness (18-36 months)
// ============================================================================

enum PottySignal {
  DRY_TWO_HOURS
  HIDES_TO_POOP
  DISCOMFORT_DIRTY_DIAPER
  INTEREST_IN_TOILET
  PULLS_PANTS_UP_DOWN
  ANNOUNCES_NEED
}

model PottyReadinessLog {
  id        String        @id @default(cuid())
  childId   String        @map("child_id")
  time      DateTime
  signals   PottySignal[]
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, time])
  @@map("potty_readiness_logs")
}

// ============================================================================
// Vaccinations (Norwegian childhood immunisation programme)
// ============================================================================

model VaccinationRecord {
  id         String   @id @default(cuid())
  childId    String   @map("child_id")
  // Key into the static programme in @baby-atlas/utils (vaccination.ts)
  vaccineKey String   @map("vaccine_key")
  givenAt    DateTime @map("given_at") @db.Date
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, vaccineKey])
  @@map("vaccination_records")
}

// ============================================================================
// Journal (shared per child, photos live in private storage, never public)
// ============================================================================

enum JournalTag {
  SICKNESS
  MILESTONE
  FIRST_TIME
  CLINIC
  FUNNY
  EVERYDAY
}

model JournalEntry {
  id        String       @id @default(cuid())
  childId   String       @map("child_id")
  authorId  String?      @map("author_id")
  date      DateTime     @db.Date
  text      String
  tags      JournalTag[]
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  child  Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  author User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  photos JournalPhoto[]

  @@index([childId, date])
  @@map("journal_entries")
}

model JournalPhoto {
  id         String   @id @default(cuid())
  entryId    String   @map("entry_id")
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  width      Int
  height     Int
  sizeBytes  Int      @map("size_bytes")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, position])
  @@map("journal_photos")
}

// ============================================================================
// Push notifications, health station calendar, handover and wellbeing
// ============================================================================

enum NotificationKind {
  TIMER_RUNNING
  MEDICINE_NEXT_DOSE
  FEED_DUE
  NAP_DUE
  CHECKUP_REMINDER
  VACCINE_REMINDER
  WEEKLY_DIGEST
  WEEKLY_TIP
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationSettings {
  userId          String             @id @map("user_id")
  enabledKinds    NotificationKind[] @default([TIMER_RUNNING, MEDICINE_NEXT_DOSE, CHECKUP_REMINDER, VACCINE_REMINDER, WEEKLY_DIGEST, WEEKLY_TIP]) @map("enabled_kinds")
  mutedChildIds   String[]           @default([]) @map("muted_child_ids")
  // Quiet hours in minutes after midnight, Europe/Oslo (null = no quiet hours)
  quietStart      Int?               @default(1320) @map("quiet_start")
  quietEnd        Int?               @default(420) @map("quiet_end")
  // Optional per-activity overrides of the forgotten timer thresholds, in minutes
  timerThresholds Json?              @map("timer_thresholds")
  locale          String             @default("nb")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationLog {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  childId   String?          @map("child_id")
  kind      NotificationKind
  dedupeKey String           @map("dedupe_key")
  sentAt    DateTime         @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([sentAt])
  @@map("notification_logs")
}

model CheckupRecord {
  id          String    @id @default(cuid())
  childId     String    @map("child_id")
  // Key into the static health station programme in @baby-atlas/utils
  checkupKey  String    @map("checkup_key")
  // Booked appointment (date and time)
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at") @db.Date
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, checkupKey])
  @@map("checkup_records")
}

// When a user last looked at a child, used by the handover summary
model ChildVisit {
  userId     String   @map("user_id")
  childId    String   @map("child_id")
  lastSeenAt DateTime @map("last_seen_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([userId, childId])
  @@map("child_visits")
}

// Private to the user: never shown to other household members
model ParentCheckIn {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  date       DateTime @db.Date
  // 1 (low) to 5 (good)
  mood       Int
  sleepHours Float?   @map("sleep_hours")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("parent_check_ins")
}
